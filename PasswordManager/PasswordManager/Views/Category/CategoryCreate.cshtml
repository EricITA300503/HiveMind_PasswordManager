@model PasswordManager.Models.Category
@{
    ViewBag.Title = "Create Category";
}

<h2>Create New Category</h2>

<form asp-action="Create" method="post" class="mt-4" style="max-width: 500px;">
    <div class="mb-3">
        <label asp-for="_name" class="form-label font-weight-bold">Category Name</label>
        <input asp-for="_name" class="form-control" placeholder="e.g. Work, Personal, Finance" required />
        <span asp-validation-for="_name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save Category</button>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
</form>