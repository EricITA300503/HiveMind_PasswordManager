@model IEnumerable<PasswordManager.Models.VaultEntry>
@{
    ViewBag.Title = "My Vault";
}

<h2>My Vault</h2>

<form method="get" class="mb-3">
    <div class="input-group">
        <input class="form-control" name="search" placeholder="Search sites..." />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>

<a asp-action="Create" class="btn btn-success mb-2">+ Add Entry</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr><th>Site</th><th>Username</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@entry._siteName</td>
                <td>@entry._username</td>
                <td>
                    <a asp-action="Details" asp-route-id="@entry._entryId">View</a> |
                    <a asp-action="Edit" asp-route-id="@entry._entryId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@entry._entryId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
