@model PasswordManager.Models.VaultEntry

<h2>Create Entry</h2>

<form asp-action="Create" method="post">
    <input asp-for="_siteName" placeholder="Site" class="form-control mb-2" />
    <input asp-for="_siteUrl" placeholder="URL" class="form-control mb-2" />
    <input asp-for="_username" placeholder="Username" class="form-control mb-2" />
    <input asp-for="_encryptedPassword" type="password" placeholder="Password" class="form-control mb-2" />
    <textarea asp-for="_notes" placeholder="Notes" class="form-control mb-2"></textarea>

    <button type="submit" class="btn btn-primary">Save</button>
</form>