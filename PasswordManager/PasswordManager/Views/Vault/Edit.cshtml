@model PasswordManager.Models.VaultEntry

<h2>Edit Entry</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="_entryId" />

    <input asp-for="_siteName" class="form-control mb-2" />
    <input asp-for="_siteUrl" class="form-control mb-2" />
    <input asp-for="_username" class="form-control mb-2" />
    <input asp-for="_encryptedPassword" class="form-control mb-2" />
    <textarea asp-for="_notes" class="form-control mb-2"></textarea>

    <button type="submit" class="btn btn-primary">Update</button>
</form>