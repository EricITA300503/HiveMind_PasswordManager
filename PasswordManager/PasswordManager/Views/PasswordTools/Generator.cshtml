@model PasswordManager.Models.ViewModels.PasswordOptions
@{
    ViewBag.Title = "Password Generator";
}

<h2>Password Generator</h2>

<div class="row mt-4">
    <div class="col-md-6">
        <form asp-action="Generator" method="post" class="card p-4 shadow-sm">
            <div class="mb-3">
                <label asp-for="Length" class="form-label font-weight-bold">
                    Password Length: <span id="lengthDisplay">@Model.Length</span>
                </label>
                <input asp-for="Length" type="range" class="form-range" min="8" max="64"
                       oninput="document.getElementById('lengthDisplay').innerText = this.value" />
            </div>

            <div class="form-check mb-2">
                <input asp-for="IncludeUppercase" class="form-check-input" id="chkUpper" />
                <label asp-for="IncludeUppercase" class="form-check-label">Include Uppercase</label>
            </div>

            <div class="form-check mb-2">
                <input asp-for="IncludeNumbers" class="form-check-input" id="chkNumbers" />
                <label asp-for="IncludeNumbers" class="form-check-label">Include Numbers</label>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IncludeSymbols" class="form-check-input" id="chkSymbols" />
                <label asp-for="IncludeSymbols" class="form-check-label">Include Symbols</label>
            </div>

            <button type="button" class="btn btn-primary w-100" id="btnGenerate">Generate Password</button>
        </form>
    </div>

    <div class="col-md-6 mt-4 mt-md-0">
        <div class="alert alert-success h-100">
            <h4 class="alert-heading">Your Password:</h4>
            <div class="bg-white border rounded p-3 mb-3 mt-3">
                <input id="generatedPassword" class="form-control text-center" readonly />
            </div>
            <hr />
            <div class="progress mb-2">
                <div id="strengthBar" class="progress-bar" style="width: 20%"></div>
            </div>
            <p class="mb-0"><strong>Strength:</strong> <span id="strengthLabel">-</span></p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#btnGenerate').on('click', function () {
            const opts = {
                length: parseInt($('#Length').val()),
                includeUppercase: $('#chkUpper').is(':checked'),
                includeNumbers: $('#chkNumbers').is(':checked'),
                includeSymbols: $('#chkSymbols').is(':checked')
            };

            $.ajax({
                url: '/api/passwordtools/generate',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(opts),
                success: function (res) {
                    $('#generatedPassword').val(res.password);
                    checkStrength(res.password);
                }
            });
        });

        function checkStrength(pw) {
            $.get('/api/passwordtools/strength', { pw: pw }, function (res) {
                const colours = ['danger', 'warning', 'info', 'success', 'success'];
                $('#strengthBar')
                    .removeClass('bg-danger bg-warning bg-info bg-success')
                    .addClass('bg-' + colours[res.score])
                    .css('width', ((res.score + 1) * 20) + '%');
                $('#strengthLabel').text(res.label);
            });
        }

        $('#generatedPassword').on('input', function () {
            checkStrength($(this).val());
        });
    </script>
}