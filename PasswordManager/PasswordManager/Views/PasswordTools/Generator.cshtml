@model PasswordManager.Models.ViewModels.PasswordOptions
@{
    ViewBag.Title = "Password Generator";
}

<h2>Password Generator</h2>

<div class="row mt-4">
    <div class="col-md-6">
        <form asp-action="Generator" method="post" class="card p-4 shadow-sm">
            <div class="mb-3">
                <label asp-for="Length" class="form-label font-weight-bold">Password Length: <span id="lengthDisplay">@Model.Length</span></label>
                <input asp-for="Length" type="range" class="form-range" min="8" max="64" oninput="document.getElementById('lengthDisplay').innerText = this.value" />
            </div>

            <div class="form-check mb-2">
                <input asp-for="IncludeUppercase" class="form-check-input" />
                <label asp-for="IncludeUppercase" class="form-check-label">Include Uppercase</label>
            </div>

            <div class="form-check mb-2">
                <input asp-for="IncludeNumbers" class="form-check-input" />
                <label asp-for="IncludeNumbers" class="form-check-label">Include Numbers</label>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IncludeSymbols" class="form-check-input" />
                <label asp-for="IncludeSymbols" class="form-check-label">Include Symbols</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Generate Password</button>
        </form>
    </div>

    @if (ViewBag.GeneratedPassword != null)
    {
        <div class="col-md-6 mt-4 mt-md-0">
            <div class="alert alert-success h-100">
                <h4 class="alert-heading">Your Password:</h4>
                <div class="bg-white border rounded p-3 mb-3 mt-3">
                    <p class="fs-4 font-monospace text-break mb-0 text-center">@ViewBag.GeneratedPassword</p>
                </div>
                <hr />
                <p class="mb-0"><strong>Strength:</strong> @ViewBag.StrengthLabel (Score: @ViewBag.StrengthScore / 4)</p>
            </div>
        </div>
    }
</div>