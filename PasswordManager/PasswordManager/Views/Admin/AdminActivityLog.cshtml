@model IEnumerable<PasswordManager.Models.ActivityLog>

<h2>Activity Log</h2>

<table class="table">
    <thead>
        <tr>
            <th>Log ID</th>
            <th>User ID</th>
            <th>Action</th>
            <th>IP Address</th>
            <th>Timestamp</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log._logId</td>
                <td>@log._userId</td>
                <td>@log._action</td>
                <td>@log._ipAddress</td>
                <td>@log._timestamp</td>
            </tr>
        }
    </tbody>
</table>