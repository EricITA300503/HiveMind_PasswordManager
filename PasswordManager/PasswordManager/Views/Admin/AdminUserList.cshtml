@model IEnumerable<PasswordManager.Models.ApplicationUser>
@{
    ViewBag.Title = "User Management";
}

<h2>Admin: User Management</h2>

<table class="table table-striped table-bordered mt-4 shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Email / Username</th>
            <th>ID</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td class="align-middle">@user.Email</td>
                <td class="align-middle font-monospace text-muted small">@user.Id</td>
                <td>
                    <form asp-action="ToggleActive" method="post" class="d-inline">
                        <input type="hidden" name="userId" value="@user.Id" />
                        <button type="submit" class="btn btn-sm btn-warning">Toggle Lockout</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>